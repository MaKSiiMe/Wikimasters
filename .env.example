# =============================================================================
#  WikiMasters — configuration (copiez vers `.env`, ou collez dans Portainer)
#  Toutes les valeurs ont un défaut raisonnable : seul DISCORD_WEBHOOK_URL
#  est à renseigner pour recevoir les alertes.
# =============================================================================

# --- Tracker Wikipédia -------------------------------------------------------
# Projet Wikimedia des cartes (les cartes WikiMasters sont en français).
WIKI_PROJECT=fr.wikipedia.org
# Contact inclus dans le User-Agent (exigé par la politique Wikimedia) :
# une URL de dépôt ou une adresse e-mail.
TRACKER_CONTACT=https://github.com/MaKSiiMe/WikiMasters
# Articles supplémentaires à suivre, séparés par des virgules
# (en plus de tracker/articles.txt et des cartes vues par le userscript).
TRACKER_ARTICLES=
# Période d'un cycle complet de collecte (secondes).
TRACKER_INTERVAL_SECONDS=3600
# Historique quotidien récupéré au premier suivi d'un article (entraînement ML).
BACKFILL_DAYS=730
# Volumes horaires via les dumps Wikimedia (~60 Mo téléchargés par heure).
# L'API REST per-article ne fournit que du quotidien.
ENABLE_HOURLY_DUMPS=true
HOURLY_BOOTSTRAP_HOURS=48
MAX_TRACKED_ARTICLES=2000

# --- Alertes -----------------------------------------------------------------
# Pic déclencheur : +300 % sur 24 h glissantes...
SPIKE_THRESHOLD_PCT=300
# ...et au moins N vues sur ces 24 h (évite 2 -> 8 vues = +300 %).
SPIKE_MIN_VIEWS=500
DISCORD_WEBHOOK_URL=

# --- API relais --------------------------------------------------------------
API_PORT=3000
# Mettez 127.0.0.1 si l'API passe derrière un reverse proxy HTTPS local.
API_BIND=0.0.0.0
# Origines autorisées (séparées par des virgules).
CORS_ORIGINS=https://www.wiki-masters.com
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=300

# --- Inférence ML ------------------------------------------------------------
# Dossier de l'hôte contenant model.onnx + model.json.
# Avec Portainer (déploiement Git), utilisez un chemin absolu, ex. /opt/wikimasters/models
MODEL_DIR_HOST=./ml_predictor/models
ORT_NUM_THREADS=1

# --- Redis / RedisInsight ----------------------------------------------------
REDIS_MAXMEMORY=256mb
REDIS_PORT=6379
REDISINSIGHT_PORT=8001
# RedisInsight n'a pas d'authentification : 127.0.0.1 + tunnel SSH si le serveur est exposé.
REDISINSIGHT_BIND=0.0.0.0

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_LEVEL_API=info
